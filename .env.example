# El servidor lee variables del entorno; cargar este archivo con set -a / source.
APP_HOST=0.0.0.0
APP_PORT=8000
# sqlite SOLO para pruebas locales. En AWS usar PostgreSQL.
DB_MODE=sqlite
SQLITE_PATH=airline-local.db
# DSN PostgreSQL; preferir conninfo con campos separados si la clave contiene caracteres especiales.
DATABASE_URL="host=RDS_ENDPOINT port=5432 dbname=airline user=airline password=CAMBIAR sslmode=require"
DB_POOL_MAX=20
AWS_DEFAULT_REGION=us-east-1
ATHENA_DATABASE=airline_analytics
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT=s3://CAMBIAR/athena-results/
ATHENA_METRICS_TABLE=route_month_metrics
ATHENA_TIMEOUT_SECONDS=9
